ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=hmac-sha256$replace-with-generated-value
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_COOKIE_SECURE=true
TUTORIAL_HMX_PASSWORD_HASH=hmac-sha256$replace-with-generated-value
TUTORIAL_PHQ_PASSWORD_HASH=hmac-sha256$replace-with-generated-value
TUTORIAL_EZY_PASSWORD_HASH=hmac-sha256$replace-with-generated-value
TUTORIAL_WDJ_PASSWORD_HASH=hmac-sha256$replace-with-generated-value
DATA_DIRECTORY=/app/data
