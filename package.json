{
  "name": "riichi-tournament-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && wrangler deploy --autoconfig=false",
    "cf:deploy:pages": "wrangler pages deploy cloudflare-pages-proxy --project-name riichi-tournament-manager --branch main --commit-dirty=true",
    "cf:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:seed:build": "node scripts/build-d1-seed.mjs",
    "cf:db:local": "wrangler d1 migrations apply riichi-tournament-manager --local",
    "cf:db:remote": "wrangler d1 migrations apply riichi-tournament-manager --remote",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:legacy": "node scripts/import-legacy-xrc.mjs",
    "backfill:naga-ratings": "vite-node scripts/backfill-naga-ratings.ts",
    "audit:excel": "node scripts/audit-xrc-excel.mjs",
    "admin:credentials": "vite-node scripts/generate-admin-credentials.ts"
  },
  "dependencies": {
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@opennextjs/cloudflare": "^1.20.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vitest": "3.2.4",
    "wrangler": "^4.127.1"
  }
}
